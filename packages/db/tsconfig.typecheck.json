{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Widened from the build config's "src" so CLI scripts and tests are also
    // type-checked. Harmless here because nothing is emitted.
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist"]
}
