# ─── Copy to .env and adjust. Never commit .env. ────────────────────────────────

# NODE_ENV is deliberately NOT set here. Next.js and the worker set it themselves,
# and forcing NODE_ENV=development breaks `next build` (React's server renderer
# picks the wrong condition and prerendering fails with a null useContext).
LOG_LEVEL=debug

# ─── Postgres ───────────────────────────────────────────────────────────────────
# Docker Compose stack:
#   postgresql://testcenter:testcenter@localhost:5432/testcenter
# Native brew install (macOS, no Docker):
#   postgresql://$(whoami)@localhost:5432/testcenter
DATABASE_URL=postgresql://testcenter:testcenter@localhost:5432/testcenter

# Retention: how many monthly partitions of test_results to keep.
# 12 months at the planned volume (<50k tests/day) is ~18M rows. Dropping a
# partition is an instant DDL delete — this is why the table is partitioned.
TESTCENTER_RETENTION_MONTHS=12
# How many future partitions to pre-create so ingest never hits a missing range.
TESTCENTER_PARTITION_LOOKAHEAD=2

# ─── Redis (queue + cache + SSE pub/sub) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (raw report artifacts + attachments) ────────────────────────
# "fs" = local filesystem, zero infrastructure, for dev without Docker/MinIO.
# "s3" = any S3-compatible endpoint (MinIO locally, S3/R2/Spaces in prod).
BLOB_DRIVER=fs
BLOB_BUCKET=testcenter-artifacts
BLOB_LOCAL_DIR=.data/blobs

# Only read when BLOB_DRIVER=s3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=testcenter
S3_SECRET_ACCESS_KEY=testcenter
S3_FORCE_PATH_STYLE=true

# ─── Auth (Auth.js + Google Workspace OIDC) ─────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated email domains allowed to sign in. Empty = allow all (dev only).
AUTH_ALLOWED_DOMAINS=testcenter.dev
# Platform admins see and may grant access to every organisation. Re-asserted from
# this list on every sign-in, so removing an address here revokes the privilege.
TESTCENTER_ADMIN_EMAILS=
# Password-less local sign-in for testing several users against one another. Enabled
# by default in development and impossible in production; set "false" to disable.
AUTH_DEV_LOGIN=true

# ─── Ingest limits ──────────────────────────────────────────────────────────────
MAX_ARTIFACT_BYTES=524288000
MAX_RUN_BYTES=5368709120

# Ceiling for the one-command endpoint, POST /api/v1/ingest. Much lower than the two above and
# for a different reason: that path buffers the upload in the web process, so this is a memory
# budget. Measured, a 191 MiB upload costs ~1.1 GB of RSS while it is handled — roughly 7x, as
# the body is materialised several times over. Budget for concurrent uploads x limit x ~7, and
# prefer POST /api/v1/runs (presigned, streams to object storage, no such limit) for anything
# genuinely large. Must not exceed MAX_ARTIFACT_BYTES; the app refuses to boot if it does.
MAX_SINGLE_SHOT_BYTES=104857600

# Caps on the free text one test result can carry. Raise MAX_OUTPUT_CHARS when suites write
# long step logs to <system-out> and you want to keep them; it is the ceiling per row, and
# test_results is partitioned monthly, so it multiplies by every run a chatty test appears in.
# OUTPUT_READ_CHARS is separate on purpose: it caps what a multi-row view returns, so the
# test-history timeline stays light even when rows are allowed to be large. A view showing one
# execution can ask for the full ceiling.
MAX_OUTPUT_CHARS=200000
OUTPUT_READ_CHARS=64000
MAX_STACK_CHARS=64000
MAX_MESSAGE_CHARS=8000

# ─── Observability (optional in dev) ────────────────────────────────────────────
OTEL_SERVICE_NAME=test-center
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
